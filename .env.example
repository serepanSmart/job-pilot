# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Database: Neon serverless Postgres (free tier) ---
# Use the POOLED connection string from the Neon dashboard.
DATABASE_URL=

# --- Dashboard auth (single user) ---
# Any strong passphrase. The signed httpOnly session cookie is HMAC'd with
# this value, so changing it invalidates existing sessions. No separate
# cookie secret is needed.
DASHBOARD_PASSWORD=

# --- LLM credentials (Phase 3) ---
# ALL LLM calls go through the EPAM CodeMie gateway (hard constraint #8).
# The pipeline reads ONLY this variable; a zero-arg Anthropic SDK client or any
# ambient ANTHROPIC_API_KEY read would bill the Unity Enterprise seat silently.
#
# Get the current SSO bearer token:
#   codemie profile status   (shows Auth Status + token lifetime)
# The token expires in ~24h. For CI/CD a long-lived service token is needed —
# strategy decided in Phase 4.
JOBPILOT_CODEMIE_TOKEN=

# --- Digest email: Resend (free tier) ---
RESEND_API_KEY=
# Domain-less onboarding sender; works without verifying a domain.
DIGEST_EMAIL_FROM=onboarding@resend.dev
# Your own inbox — Resend's free sender can only deliver to this address.
DIGEST_EMAIL_TO=
# Full URL of the deployed dashboard (no trailing slash). Used in digest email links.
# Locally: http://localhost:3000 — in production: your Vercel URL.
DASHBOARD_URL=http://localhost:3000

# Do NOT add ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or CLAUDE_CODE_OAUTH_TOKEN
# here. The work Enterprise ANTHROPIC_API_KEY is exported in the shell and
# outranks everything in credential precedence. Use JOBPILOT_CODEMIE_TOKEN only.
