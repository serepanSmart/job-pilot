# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Database: Neon serverless Postgres (free tier) ---
# Use the POOLED connection string from the Neon dashboard.
DATABASE_URL=

# --- Dashboard auth (single user) ---
# Any strong passphrase. The signed httpOnly session cookie is HMAC'd with
# this value, so changing it invalidates existing sessions. No separate
# cookie secret is needed.
DASHBOARD_PASSWORD=

# --- LLM credentials (Phase 3) ---
# DELIBERATELY PREFIXED. The pipeline reads only these two names and errors out
# if both are empty. It must never fall back to ANTHROPIC_API_KEY or
# CLAUDE_CODE_OAUTH_TOKEN: on this machine a work Enterprise ANTHROPIC_API_KEY is
# exported, it outranks everything in credential precedence, and an ambient read
# would bill the employer silently. See CLAUDE.md hard constraint #8.
#
# Fill in exactly ONE of the two, from a PERSONAL account:
#   subscription path — generate with `claude setup-token` while logged in personally
JOBPILOT_CLAUDE_CODE_OAUTH_TOKEN=
#   API path — a personal key on your own billing
JOBPILOT_ANTHROPIC_API_KEY=

# --- Digest email: Resend (free tier) ---
RESEND_API_KEY=
# Domain-less onboarding sender; works without verifying a domain.
DIGEST_EMAIL_FROM=onboarding@resend.dev
# Your own inbox — Resend's free sender can only deliver to this address.
DIGEST_EMAIL_TO=

# Do NOT add a bare ANTHROPIC_API_KEY here. It is the highest-precedence
# credential, so it would override the prefixed one above — and the work
# Enterprise key already exported in the shell would win anyway. Use
# JOBPILOT_ANTHROPIC_API_KEY.
